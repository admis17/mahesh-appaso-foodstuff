# Copy to .env.local for local development. On Vercel, add the same two variables under
# Project → Settings → Environment Variables, then redeploy.
# Both values are in Supabase → Project Settings → API. The anon key is safe to expose:
# row-level security (supabase/schema.sql) limits what it can do.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key
